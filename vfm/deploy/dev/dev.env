# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT CREDENTIALS — COMMITTED ON PURPOSE. DEV ONLY.
# ---------------------------------------------------------------------------
# Every value in this file is a throwaway used by the docker compose stack in
# this directory, which binds to 127.0.0.1 only. Nothing here is ever read by a
# deployed control plane, an agent, or any Helm chart. Real secrets come from
# the environment or Kubernetes Secrets (PLAN.md §12.1).
#
# This file is deliberately NOT named `.env*`: vfm/.gitignore ignores `.env*`,
# and these values must be committed so `./scripts/dev-up.sh` works on a clean
# clone with no manual setup. Compose reads it via `--env-file dev.env`.
#
# If you ever need different values, copy this file, do not edit it, and pass
# VFM_DEV_ENV_FILE=/path/to/your.env to the scripts.
# ---------------------------------------------------------------------------

# --- compose project -------------------------------------------------------
# Hard-coded so this stack can never collide with another compose project on
# the same machine.
COMPOSE_PROJECT_NAME=vfm-dev

# --- host ports ------------------------------------------------------------
# Deliberately in the 5xxxx range. In particular PostgreSQL is NOT on 5432:
# that port is commonly already taken by another local database.
VFM_DEV_POSTGRES_PORT=55432
VFM_DEV_VALKEY_PORT=56379
VFM_DEV_MINIO_API_PORT=59000
VFM_DEV_MINIO_CONSOLE_PORT=59001
VFM_DEV_MAILPIT_SMTP_PORT=51025
VFM_DEV_MAILPIT_UI_PORT=58025
VFM_DEV_DEX_PORT=55556

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=vfm
POSTGRES_USER=vfm
POSTGRES_PASSWORD=vfm-dev-password
# Convenience for the NestJS control plane (M0 day 3 onwards).
VFM_DEV_DATABASE_URL=postgresql://vfm:vfm-dev-password@127.0.0.1:55432/vfm?schema=public

# --- Valkey (Redis-compatible) --------------------------------------------
# No password: the port is bound to 127.0.0.1 and the dev stack holds no real
# data. The control plane's own config still requires an explicit URL.
VFM_DEV_REDIS_URL=redis://127.0.0.1:56379/0

# --- MinIO -----------------------------------------------------------------
# These double as the AWS-style credentials Velero uses against MinIO; the
# dev-up script writes them into .generated/velero-credentials-minio.
MINIO_ROOT_USER=vfmdev
MINIO_ROOT_PASSWORD=vfm-dev-password
# One bucket per kind cluster.
VFM_DEV_BUCKET_A=vfm-backups-a
VFM_DEV_BUCKET_B=vfm-backups-b
# Region string Velero's AWS plugin is configured with. MinIO ignores it, but
# the AWS SDK requires some value to be set.
VFM_DEV_MINIO_REGION=minio

# --- Mailpit (SMTP catcher) ------------------------------------------------
VFM_DEV_SMTP_HOST=127.0.0.1
VFM_DEV_SMTP_PORT=51025
VFM_DEV_SMTP_FROM=vfm-dev@vfm.local

# --- Dex (mock OIDC provider) ---------------------------------------------
# The issuer must be byte-identical for the browser and the control plane, so
# it is a localhost URL on the published port.
VFM_DEV_OIDC_ISSUER=http://localhost:55556/dex
# The control plane refuses http and private-network identity providers by default; Dex on localhost needs both.
OIDC_ALLOW_HTTP=true
OIDC_ALLOW_PRIVATE=true
VFM_DEV_OIDC_CLIENT_ID=vfm-control-plane
VFM_DEV_OIDC_CLIENT_SECRET=vfm-dev-oidc-client-secret
# Password for every Dex static user in dex/config.yaml.
VFM_DEV_OIDC_USER_PASSWORD=vfm-dev-password
