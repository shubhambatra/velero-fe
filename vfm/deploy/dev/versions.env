# ---------------------------------------------------------------------------
# Every version the local dev environment pins, in one place.
# ---------------------------------------------------------------------------
# Sourced by scripts/lib.sh. The same values appear in README.md's version
# table and in docker-compose.yml (compose cannot interpolate from two env
# files at once, so compose carries its own literal tags — keep them in sync;
# scripts/dev-up.sh verifies the compose file against these values).
#
# Nothing here may be a floating tag. No `:latest`, no `canary`, no bare major.
# ---------------------------------------------------------------------------

# --- Velero (DECISIONS.md ADR-002) ----------------------------------------
# VELERO_PRIMARY. The locally installed Velero CLI is a different patch
# (v1.18.2 at the time of writing), so the server image is pinned explicitly
# with `velero install --image` rather than inherited from the CLI default.
VFM_VELERO_VERSION=v1.18.4
VFM_VELERO_IMAGE=velero/velero:v1.18.4
# Plugin v1.14.x is the line declared compatible with Velero v1.18.x by
# velero-io/velero-plugin-for-aws' own compatibility table.
VFM_VELERO_AWS_PLUGIN_IMAGE=velero/velero-plugin-for-aws:v1.14.4

# --- kind / Kubernetes -----------------------------------------------------
# kind v0.33.0-alpha's default node image, matching the local kubectl v1.36.x.
# The digest is part of the pin: a tag alone is mutable.
VFM_KIND_NODE_IMAGE=kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5
VFM_KIND_K8S_VERSION=v1.36.1

# --- CSI snapshot controller (kubernetes-csi/external-snapshotter) --------
# CRDs, RBAC and controller are vendored at this tag under
# manifests/snapshot-controller/. The version matches the csi-snapshotter
# sidecar inside the hostpath driver below.
VFM_SNAPSHOTTER_VERSION=v8.6.0
VFM_SNAPSHOT_CONTROLLER_IMAGE=registry.k8s.io/sig-storage/snapshot-controller:v8.6.0

# --- hostpath CSI driver (kubernetes-csi/csi-driver-host-path) -------------
# Manifests vendored at this tag under manifests/csi-hostpath/. The sidecar
# image pins below are upstream's own for that release.
VFM_CSI_HOSTPATH_VERSION=v1.18.0
VFM_CSI_HOSTPATH_IMAGE=registry.k8s.io/sig-storage/hostpathplugin:v1.17.1
VFM_CSI_PROVISIONER_IMAGE=registry.k8s.io/sig-storage/csi-provisioner:v6.3.0
VFM_CSI_ATTACHER_IMAGE=registry.k8s.io/sig-storage/csi-attacher:v4.12.0
VFM_CSI_RESIZER_IMAGE=registry.k8s.io/sig-storage/csi-resizer:v2.2.1
VFM_CSI_SNAPSHOTTER_IMAGE=registry.k8s.io/sig-storage/csi-snapshotter:v8.6.0
VFM_CSI_REGISTRAR_IMAGE=registry.k8s.io/sig-storage/csi-node-driver-registrar:v2.17.0
VFM_CSI_LIVENESSPROBE_IMAGE=registry.k8s.io/sig-storage/livenessprobe:v2.19.0
VFM_CSI_HEALTH_MONITOR_IMAGE=registry.k8s.io/sig-storage/csi-external-health-monitor-controller:v0.18.0

# --- compose stack images --------------------------------------------------
VFM_POSTGRES_IMAGE=postgres:16.15-alpine
VFM_VALKEY_IMAGE=valkey/valkey:7.2.14-alpine
# MinIO's own registries (docker.io/minio/minio, quay.io/minio/minio) stopped
# serving anonymous pulls and dl.min.io returns HTTP 410 for release binaries.
# These are Bitnami's archived community builds of the same MinIO releases —
# see README.md "MinIO image provenance". Dev-only, pinned, never shipped.
VFM_MINIO_IMAGE=bitnamilegacy/minio:2025.7.23-debian-12-r5
VFM_MINIO_CLIENT_IMAGE=bitnamilegacy/minio-client:2025.7.21-debian-12-r3
VFM_MAILPIT_IMAGE=axllent/mailpit:v1.31.5
VFM_DEX_IMAGE=dexidp/dex:v2.46.0

# --- sample workload images ------------------------------------------------
VFM_SAMPLE_NGINX_IMAGE=nginx:1.29.8-alpine
VFM_SAMPLE_BUSYBOX_IMAGE=busybox:1.38.0
