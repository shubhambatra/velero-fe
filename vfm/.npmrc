# React 19 and shadcn/ui pull peer ranges that are still catching up (PLAN.md §4.3 pins
# React 19, so we relax the peer check rather than downgrade the framework).
strict-peer-dependencies=false

# Keep the store inside the workspace so the legacy npm-based Nx root at the repo
# root is never touched (DECISIONS.md ADR-004).
link-workspace-packages=true
save-exact=true
