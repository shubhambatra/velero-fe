# Control-plane configuration. Copy to .env for local development.
# The complete, authoritative list of variables is src/config/env.schema.ts —
# anything not in that schema is ignored (PLAN.md §4.2).
#
# Never commit a real value for any of these (PLAN.md §12.1). In Kubernetes they
# come from a Secret, not from a file.

NODE_ENV=development
PORT=3000
METRICS_PORT=9090
HOST=0.0.0.0
LOG_LEVEL=debug
LOG_PRETTY=true

# Ports match deploy/dev/docker-compose.yml, which moves off the defaults
# because 5432 is commonly already in use on a developer machine.
DATABASE_URL=postgresql://vfm:vfm-dev-password@localhost:55432/vfm?schema=public
REDIS_URL=redis://localhost:56379

# Key-encryption key for the *_encrypted columns. 32 bytes, base64.
# REQUIRED: the database holds encrypted columns from M1 day 5 onward.
#   openssl rand -base64 32
VFM_MASTER_KEY=REPLACE_ME_WITH_openssl_rand_base64_32

# Retired keys, comma-separated, accepted for decryption only. Set this during
# a key rotation so rows encrypted under the old key stay readable until the
# rewrap job has worked through them.
# VFM_MASTER_KEY_PREVIOUS=

# Trust X-Forwarded-For? `false` (default) trusts nothing; a number is the
# count of trusted proxy hops (1 behind a single Ingress). Rate limiting keys
# on the client address, so believing the header without a proxy in front
# would let any caller walk around the per-IP limit.
# TRUST_PROXY=false

# Links in emails (invitations) point here.
# PUBLIC_URL=http://localhost:5173

# Outbound SMTP. Leave SMTP_HOST unset to run without email; invitations then
# fail with 503 rather than silently not sending. Dev sink: Mailpit on 51025.
# SMTP_HOST=localhost
# SMTP_PORT=51025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Velero Fleet Manager <no-reply@vfm.local>

# Optional LDAP sign-in for existing users (see docs/OPERATIONS.md). Leave LDAP_URL unset to disable.
# LDAP_URL=ldaps://ldap.example.com
# LDAP_SEARCH_BASE=ou=people,dc=example,dc=com
# LDAP_BIND_DN=cn=readonly,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_USER_FILTER=(mail={email})
