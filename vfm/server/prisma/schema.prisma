// Velero Fleet Manager database schema.
//
// One of the three contracts named in PLAN.md §0 rule 5. Changes are
// deliberate: edit this file, generate a migration, and record the change in
// docs/DECISIONS.md.
//
// Conventions from PLAN.md §9, applied to every model:
//   - `id` is a UUID (v7 generated in application code so ids sort by creation
//     time; see idUuidV7() in src/common/uuid.ts — Postgres has no native v7
//     generator and we do not want a extension dependency).
//   - `createdAt` / `updatedAt` on every table.
//   - every org-owned table carries `orgId` with an index, and PLAN.md §8.1
//     requires that *every* query filter on it. That is enforced by the Prisma
//     extension in src/prisma/org-scope.ts, not by convention: any model with
//     an `orgId` field is org-owned automatically, and a model without one has
//     to be named in NOT_ORG_OWNED or its test fails.
//   - columns holding secrets are suffixed `Encrypted` and hold AES-256-GCM
//     envelope ciphertext with a key id (PLAN.md §9).
//
// Tables arrive with the feature that needs them, so this is a growing subset
// of §9's list: users, organizations and memberships from M0 day 3, and
// mfa_recovery_codes from M1 day 5, and teams, team_members and invites from
// M1 day 6, and oidc_providers and oidc_identities from M1 day 7.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` here: the CLI reads it from
// prisma.config.ts and the runtime client receives it through the pg driver
// adapter (docs/DECISIONS.md ADR-007).
datasource db {
  provider = "postgresql"
}

/// A person who can sign in. Users are global; their access comes from
/// memberships and role bindings (PLAN.md §8.1).
model User {
  id String @id @db.Uuid

  /// Login identity. Normalised to lower case by the application before every
  /// read and write, so this plain unique index is effectively
  /// case-insensitive without requiring the citext extension (which would
  /// complicate air-gapped and managed-Postgres installs).
  email String @unique

  /// Display name. Optional because OIDC providers do not all supply one.
  name String?

  /// argon2id hash (PLAN.md §8.3). Null for users who only ever sign in
  /// through OIDC, so a missing hash must never be treated as "no password
  /// required".
  passwordHash String? @map("password_hash")

  /// TOTP shared secret, encrypted at rest (PLAN.md §9).
  mfaSecretEncrypted String? @map("mfa_secret_encrypted")

  mfaEnabled Boolean @default(false) @map("mfa_enabled")

  /// Highest TOTP time step already accepted for this user.
  ///
  /// A TOTP code stays valid for its whole 30-second step, so without this a
  /// code observed over someone's shoulder could be replayed within the
  /// window. Verification rejects anything at or below this value, which makes
  /// each code usable exactly once. BigInt because a step is a Unix time
  /// divided by 30 and will outlive a 32-bit integer.
  mfaLastTimeStep BigInt? @map("mfa_last_time_step")

  /// Platform super-admin. Separate from org roles: it bootstraps the first
  /// organization and is not granted by any org (PLAN.md §8.1).
  isPlatformAdmin Boolean @default(false) @map("is_platform_admin")

  /// Soft disable. Set rather than deleting, so audit rows keep referring to a
  /// real actor (PLAN.md §9 audit is append-only).
  disabledAt  DateTime? @map("disabled_at") @db.Timestamptz(6)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships      Membership[]
  teamMemberships  TeamMember[]
  oidcIdentities   OidcIdentity[]
  mfaRecoveryCodes MfaRecoveryCode[]

  @@index([disabledAt])
  @@map("users")
}

/// A single-use MFA recovery code (PLAN.md §8.3: "recovery codes (10,
/// hashed)").
///
/// One row per code rather than a JSON array on `users`, so spending a code is
/// an atomic `UPDATE … WHERE used_at IS NULL`. In a JSON column the same
/// operation would be a read-modify-write, and two requests presenting the
/// same code could both succeed.
///
/// PLAN.md §9 does not list this table; see docs/DECISIONS.md ADR-008.
model MfaRecoveryCode {
  id String @id @db.Uuid

  userId String @map("user_id") @db.Uuid

  /// SHA-256 of the normalised code. These are 80 bits of CSPRNG output, so
  /// there is nothing for an offline attacker to guess and a slow KDF would
  /// only add cost to verification — see the service for the full reasoning.
  codeHash String @map("code_hash")

  /// Set when the code is spent. Never reset; a used code stays used.
  usedAt DateTime? @map("used_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The lookup is by (user, hash, unused), which this covers.
  @@index([userId, codeHash])
  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

/// A tenant. Every piece of customer data hangs off an organization, and all
/// queries are org-scoped (PLAN.md §8.1).
model Organization {
  id   String @id @db.Uuid
  name String
  slug String @unique

  /// Org settings from PLAN.md §9: mfaRequired, allowBackupContentDownload,
  /// logCacheDays, requireRestoreApproval. Kept as JSON because the set grows
  /// each milestone and is always read as a whole. Defaults live in
  /// application code so an existing row never silently gains a permissive
  /// value.
  settings Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships   Membership[]
  teams         Team[]
  invites       Invite[]
  oidcProviders OidcProvider[]

  @@map("organizations")
}

/// A user's single role within one organization (PLAN.md §8.1). Cluster- and
/// namespace-level permissions are separate role bindings, added in M1 day 8.
enum OrgRole {
  OWNER
  ADMIN
  MEMBER

  @@map("org_role")
}

model Membership {
  id String @id @db.Uuid

  orgId  String @map("org_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  orgRole OrgRole @map("org_role")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
  @@map("memberships")
}

/// A named group of members within one organization (PLAN.md §8.1). Role
/// bindings (M1 day 8) can target a team, and OIDC group claims map onto teams
/// (M1 day 7).
model Team {
  id String @id @db.Uuid

  orgId String @map("org_id") @db.Uuid

  name        String
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members TeamMember[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("teams")
}

/// Membership of a user in a team.
///
/// `orgId` is repeated here although it is derivable through the team. That is
/// deliberate: it lets the scoping extension treat this table exactly like
/// every other org-owned table instead of needing a join, and the service
/// checks that team and user belong to the same org before inserting.
model TeamMember {
  id String @id @db.Uuid

  orgId  String @map("org_id") @db.Uuid
  teamId String @map("team_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([orgId])
  @@index([userId])
  @@map("team_members")
}

/// A pending invitation to join an organization (PLAN.md §16 day 6: "email
/// invites via SMTP").
///
/// PLAN.md §9 does not list this table; see docs/DECISIONS.md ADR-010.
model Invite {
  id String @id @db.Uuid

  orgId String @map("org_id") @db.Uuid

  /// The address the invitation is bound to. Accepting requires the accepting
  /// account to hold exactly this address, so a forwarded link is useless to
  /// anyone else.
  email   String
  orgRole OrgRole @map("org_role")

  /// SHA-256 of the token that travels in the email. The token is 256 bits of
  /// CSPRNG output, so a fast hash is sufficient (ADR-009); the point of
  /// hashing is that a database read does not yield usable invitations.
  tokenHash String @unique @map("token_hash")

  invitedById String? @map("invited_by_id") @db.Uuid

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Set once, atomically, by a conditional UPDATE. An accepted invite stays
  /// accepted; replay is refused because the UPDATE matches no row.
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, email])
  @@map("invites")
}

/// An OpenID Connect identity provider configured by an org (PLAN.md §8.3,
/// §9 `oidc_providers`). Several per org are allowed.
model OidcProvider {
  id String @id @db.Uuid

  orgId String @map("org_id") @db.Uuid

  /// Shown on the sign-in button.
  name   String
  issuer String

  clientId              String @map("client_id")
  /// AES-256-GCM envelope ciphertext, bound to this row's id (PLAN.md §9).
  clientSecretEncrypted String @map("client_secret_encrypted")

  /// Name of the ID-token claim that carries group names. Null means no group
  /// sync for this provider.
  groupClaim String? @map("group_claim")

  /// `[{ "group": "<idp group>", "teamId": "<uuid>" }]`. Validated on write so
  /// every teamId belongs to this org.
  mappings Json @default("[]")

  /// Create a user on first sign-in. Off by default (adopting SSO must not
  /// silently open the org to everyone the IdP knows).
  jitEnabled Boolean @default(false) @map("jit_enabled")

  enabled Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  org        Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  identities OidcIdentity[]

  @@index([orgId])
  @@map("oidc_providers")
}

/// Links an IdP subject to a user.
///
/// Sign-in matches on (provider, subject), never on email: an email is a
/// mutable attribute the IdP asserts, and matching on it alone would let a
/// provider (or a typo in one) sign in as someone else's account. PLAN.md §9
/// does not list this table; see docs/DECISIONS.md ADR-011.
model OidcIdentity {
  id String @id @db.Uuid

  orgId      String @map("org_id") @db.Uuid
  providerId String @map("provider_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid

  /// The `sub` claim.
  subject String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  provider OidcProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, subject])
  @@index([orgId])
  @@index([userId])
  @@map("oidc_identities")
}
