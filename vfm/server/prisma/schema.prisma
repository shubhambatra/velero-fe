// Velero Fleet Manager database schema.
//
// One of the three contracts named in PLAN.md §0 rule 5. Changes are
// deliberate: edit this file, generate a migration, and record the change in
// docs/DECISIONS.md.
//
// Conventions from PLAN.md §9, applied to every model:
//   - `id` is a UUID (v7 generated in application code so ids sort by creation
//     time; see idUuidV7() in src/common/uuid.ts — Postgres has no native v7
//     generator and we do not want a extension dependency).
//   - `createdAt` / `updatedAt` on every table.
//   - every org-owned table carries `orgId` with an index, and PLAN.md §8.1
//     requires that *every* query filter on it. That is enforced by the Prisma
//     extension in src/prisma/org-scope.ts, not by convention: any model with
//     an `orgId` field is org-owned automatically, and a model without one has
//     to be named in NOT_ORG_OWNED or its test fails.
//   - columns holding secrets are suffixed `Encrypted` and hold AES-256-GCM
//     envelope ciphertext with a key id (PLAN.md §9).
//
// Tables arrive with the feature that needs them, so this is a growing subset
// of §9's list: users, organizations and memberships from M0 day 3, and
// mfa_recovery_codes from M1 day 5, and teams, team_members and invites from
// M1 day 6, and oidc_providers and oidc_identities from M1 day 7.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` here: the CLI reads it from
// prisma.config.ts and the runtime client receives it through the pg driver
// adapter (docs/DECISIONS.md ADR-007).
datasource db {
  provider = "postgresql"
}

/// A person who can sign in. Users are global; their access comes from
/// memberships and role bindings (PLAN.md §8.1).
model User {
  id String @id @db.Uuid

  /// Login identity. Normalised to lower case by the application before every
  /// read and write, so this plain unique index is effectively
  /// case-insensitive without requiring the citext extension (which would
  /// complicate air-gapped and managed-Postgres installs).
  email String @unique

  /// Display name. Optional because OIDC providers do not all supply one.
  name String?

  /// argon2id hash (PLAN.md §8.3). Null for users who only ever sign in
  /// through OIDC, so a missing hash must never be treated as "no password
  /// required".
  passwordHash String? @map("password_hash")

  /// TOTP shared secret, encrypted at rest (PLAN.md §9).
  mfaSecretEncrypted String? @map("mfa_secret_encrypted")

  mfaEnabled Boolean @default(false) @map("mfa_enabled")

  /// Highest TOTP time step already accepted for this user.
  ///
  /// A TOTP code stays valid for its whole 30-second step, so without this a
  /// code observed over someone's shoulder could be replayed within the
  /// window. Verification rejects anything at or below this value, which makes
  /// each code usable exactly once. BigInt because a step is a Unix time
  /// divided by 30 and will outlive a 32-bit integer.
  mfaLastTimeStep BigInt? @map("mfa_last_time_step")

  /// Platform super-admin. Separate from org roles: it bootstraps the first
  /// organization and is not granted by any org (PLAN.md §8.1).
  isPlatformAdmin Boolean @default(false) @map("is_platform_admin")

  /// Soft disable. Set rather than deleting, so audit rows keep referring to a
  /// real actor (PLAN.md §9 audit is append-only).
  disabledAt  DateTime? @map("disabled_at") @db.Timestamptz(6)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships      Membership[]
  teamMemberships  TeamMember[]
  oidcIdentities   OidcIdentity[]
  mfaRecoveryCodes MfaRecoveryCode[]
  apiTokens        ApiToken[]

  @@index([disabledAt])
  @@map("users")
}

/// A single-use MFA recovery code (PLAN.md §8.3: "recovery codes (10,
/// hashed)").
///
/// One row per code rather than a JSON array on `users`, so spending a code is
/// an atomic `UPDATE … WHERE used_at IS NULL`. In a JSON column the same
/// operation would be a read-modify-write, and two requests presenting the
/// same code could both succeed.
///
/// PLAN.md §9 does not list this table; see docs/DECISIONS.md ADR-008.
model MfaRecoveryCode {
  id String @id @db.Uuid

  userId String @map("user_id") @db.Uuid

  /// SHA-256 of the normalised code. These are 80 bits of CSPRNG output, so
  /// there is nothing for an offline attacker to guess and a slow KDF would
  /// only add cost to verification — see the service for the full reasoning.
  codeHash String @map("code_hash")

  /// Set when the code is spent. Never reset; a used code stays used.
  usedAt DateTime? @map("used_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The lookup is by (user, hash, unused), which this covers.
  @@index([userId, codeHash])
  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

/// A tenant. Every piece of customer data hangs off an organization, and all
/// queries are org-scoped (PLAN.md §8.1).
model Organization {
  id   String @id @db.Uuid
  name String
  slug String @unique

  /// Org settings from PLAN.md §9: mfaRequired, allowBackupContentDownload,
  /// logCacheDays, requireRestoreApproval. Kept as JSON because the set grows
  /// each milestone and is always read as a whole. Defaults live in
  /// application code so an existing row never silently gains a permissive
  /// value.
  settings Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships   Membership[]
  teams         Team[]
  invites       Invite[]
  oidcProviders OidcProvider[]
  roleBindings  RoleBinding[]
  apiTokens     ApiToken[]
  clusters      Cluster[]

  @@map("organizations")
}

/// A user's single role within one organization (PLAN.md §8.1). Cluster- and
/// namespace-level permissions are separate role bindings, added in M1 day 8.
enum OrgRole {
  OWNER
  ADMIN
  MEMBER

  @@map("org_role")
}

model Membership {
  id String @id @db.Uuid

  orgId  String @map("org_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  orgRole OrgRole @map("org_role")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
  @@map("memberships")
}

/// A named group of members within one organization (PLAN.md §8.1). Role
/// bindings (M1 day 8) can target a team, and OIDC group claims map onto teams
/// (M1 day 7).
model Team {
  id String @id @db.Uuid

  orgId String @map("org_id") @db.Uuid

  name        String
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members TeamMember[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("teams")
}

/// Membership of a user in a team.
///
/// `orgId` is repeated here although it is derivable through the team. That is
/// deliberate: it lets the scoping extension treat this table exactly like
/// every other org-owned table instead of needing a join, and the service
/// checks that team and user belong to the same org before inserting.
model TeamMember {
  id String @id @db.Uuid

  orgId  String @map("org_id") @db.Uuid
  teamId String @map("team_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([orgId])
  @@index([userId])
  @@map("team_members")
}

/// A pending invitation to join an organization (PLAN.md §16 day 6: "email
/// invites via SMTP").
///
/// PLAN.md §9 does not list this table; see docs/DECISIONS.md ADR-010.
model Invite {
  id String @id @db.Uuid

  orgId String @map("org_id") @db.Uuid

  /// The address the invitation is bound to. Accepting requires the accepting
  /// account to hold exactly this address, so a forwarded link is useless to
  /// anyone else.
  email   String
  orgRole OrgRole @map("org_role")

  /// SHA-256 of the token that travels in the email. The token is 256 bits of
  /// CSPRNG output, so a fast hash is sufficient (ADR-009); the point of
  /// hashing is that a database read does not yield usable invitations.
  tokenHash String @unique @map("token_hash")

  invitedById String? @map("invited_by_id") @db.Uuid

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Set once, atomically, by a conditional UPDATE. An accepted invite stays
  /// accepted; replay is refused because the UPDATE matches no row.
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, email])
  @@map("invites")
}

/// An OpenID Connect identity provider configured by an org (PLAN.md §8.3,
/// §9 `oidc_providers`). Several per org are allowed.
model OidcProvider {
  id String @id @db.Uuid

  orgId String @map("org_id") @db.Uuid

  /// Shown on the sign-in button.
  name   String
  issuer String

  clientId              String @map("client_id")
  /// AES-256-GCM envelope ciphertext, bound to this row's id (PLAN.md §9).
  clientSecretEncrypted String @map("client_secret_encrypted")

  /// Name of the ID-token claim that carries group names. Null means no group
  /// sync for this provider.
  groupClaim String? @map("group_claim")

  /// `[{ "group": "<idp group>", "teamId": "<uuid>" }]`. Validated on write so
  /// every teamId belongs to this org.
  mappings Json @default("[]")

  /// Create a user on first sign-in. Off by default (adopting SSO must not
  /// silently open the org to everyone the IdP knows).
  jitEnabled Boolean @default(false) @map("jit_enabled")

  enabled Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  org        Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  identities OidcIdentity[]

  @@index([orgId])
  @@map("oidc_providers")
}

/// Links an IdP subject to a user.
///
/// Sign-in matches on (provider, subject), never on email: an email is a
/// mutable attribute the IdP asserts, and matching on it alone would let a
/// provider (or a typo in one) sign in as someone else's account. PLAN.md §9
/// does not list this table; see docs/DECISIONS.md ADR-011.
model OidcIdentity {
  id String @id @db.Uuid

  orgId      String @map("org_id") @db.Uuid
  providerId String @map("provider_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid

  /// The `sub` claim.
  subject String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  provider OidcProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, subject])
  @@index([orgId])
  @@index([userId])
  @@map("oidc_identities")
}

enum RoleBindingSubject {
  USER
  TEAM

  @@map("role_binding_subject")
}

/// Grants a user or team a built-in cluster role, optionally limited to some
/// namespaces (PLAN.md §8.2, §9). Evaluated by `authorize()` in @vfm/shared.
///
/// `clusterId` references `clusters` (the constraint ADR-012 deferred until M2).
/// `subjectId` is polymorphic (user or team) and so cannot be a foreign key
/// either; the service validates it and removes bindings when the subject
/// leaves the org or is deleted.
model RoleBinding {
  id String @id @db.Uuid

  orgId     String @map("org_id") @db.Uuid
  clusterId String @map("cluster_id") @db.Uuid

  subjectType RoleBindingSubject @map("subject_type")
  subjectId   String             @map("subject_id") @db.Uuid

  /// A built-in role key (`VIEWER`, `OPERATOR`, `RESTORER`, `CLUSTER_ADMIN`).
  /// A string, not an enum, so v1.1 custom roles need no migration.
  role String

  /// `{type: CLUSTER}` | `{type: NAMESPACES, namespaces}` | `{type: SELECTOR, selector}`.
  scope Json

  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cluster Cluster      @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@index([orgId, clusterId])
  @@index([orgId, subjectType, subjectId])
  @@map("role_bindings")
}

enum AuditActorType {
  USER
  TOKEN
  SYSTEM
  AGENT

  @@map("audit_actor_type")
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILED

  @@map("audit_outcome")
}

/// Append-only record of who did what, where, when and with what result
/// (PLAN.md §8.4, §9; principle P5).
///
/// No foreign keys, on purpose: an audit row must outlive the org, user or
/// cluster it describes, and a cascade would make deletion a way to erase
/// history. Immutability is enforced by a database trigger, not by the
/// application (docs/DECISIONS.md ADR-013).
///
/// `orgId` is nullable because some events precede any org (a failed login).
model AuditEvent {
  id String @id @db.Uuid

  orgId String? @map("org_id") @db.Uuid

  actorType AuditActorType @map("actor_type")
  actorId   String?        @map("actor_id") @db.Uuid

  /// `METHOD /route/:pattern` for API calls, or a dotted name for events the
  /// application records itself (`auth.oidc.login`).
  action String

  targetType String? @map("target_type")
  targetId   String? @map("target_id")
  clusterId  String? @map("cluster_id") @db.Uuid

  ip        String?
  userAgent String? @map("user_agent")
  requestId String? @map("request_id")

  outcome AuditOutcome

  /// Redacted. Holds field *names* and status codes, never request values.
  details Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orgId, id])
  @@index([orgId, actorId])
  @@index([orgId, clusterId])
  @@index([orgId, action])
  @@map("audit_events")
}

/// A long-lived credential for automation (PLAN.md §8.3, §9).
///
/// Acts as `userId` inside `orgId`, never with more than that user holds: at
/// use time the user's own grants are intersected with `permissions` and
/// `clusterIds`, so a token cannot outlive a demotion or outgrow its owner.
/// Only the SHA-256 of the token is stored (ADR-009); the plaintext is shown
/// once, at creation.
model ApiToken {
  id String @id @db.Uuid

  orgId  String @map("org_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  name String

  /// `vfm_` plus the first characters of the secret, for recognising a token
  /// in a list. Not sufficient to authenticate.
  prefix    String
  tokenHash String @unique @map("token_hash")

  /// Permission keys the token is limited to; `null` means "all of the
  /// owner's", which is the owner's permissions, not every permission.
  permissions Json?
  /// Cluster ids the token is limited to; `null` means all of the owner's.
  clusterIds  Json? @map("cluster_ids")

  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
  @@map("api_tokens")
}

enum ClusterStatus {
  /// Created in the UI; no agent has enrolled yet.
  PENDING
  /// An agent enrolled and holds a certificate, but is not connected now.
  ENROLLED
  CONNECTED
  DISCONNECTED
  /// Turned off by an admin: certificates revoked, enrollment refused.
  DISABLED

  @@map("cluster_status")
}

/// A Kubernetes cluster managed through an agent (PLAN.md §9, §5.1).
///
/// Everything from `fingerprint` down is reported by the agent and is only as
/// trustworthy as the agent; it is display data, never an input to an
/// authorization decision.
model Cluster {
  id String @id @db.Uuid

  orgId String @map("org_id") @db.Uuid
  name  String

  status ClusterStatus @default(PENDING)

  /// UID of the cluster's `kube-system` namespace, recorded at enrollment. A
  /// later Hello with a different value means the agent moved clusters.
  fingerprint String?

  k8sVersion      String? @map("k8s_version")
  veleroVersion   String? @map("velero_version")
  veleroPlugins   Json?   @map("velero_plugins")
  agentVersion    String? @map("agent_version")
  protocolVersion Int?    @map("protocol_version")
  agentPolicy     Json?   @map("agent_policy")
  capabilities    Json?

  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)

  labels             Json    @default("{}")
  grafanaUrlTemplate String? @map("grafana_url_template")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  org             Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bootstrapTokens ClusterBootstrapToken[]
  certificates    AgentCertificate[]
  roleBindings    RoleBinding[]

  @@unique([orgId, name])
  @@index([orgId, status])
  @@map("clusters")
}

/// One-time enrollment credential (PLAN.md §5.1): 32 random bytes, stored as a
/// SHA-256 hash, valid 24 h, burned by a conditional UPDATE on first use.
///
/// `orgId` is denormalised from the cluster so the table is org-scoped like
/// every other (docs/DECISIONS.md ADR-016); enrollment itself runs unscoped
/// because the caller is identified by the token, not by a session.
model ClusterBootstrapToken {
  id String @id @db.Uuid

  orgId     String @map("org_id") @db.Uuid
  clusterId String @map("cluster_id") @db.Uuid

  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cluster Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([clusterId])
  @@map("cluster_bootstrap_tokens")
}

/// A client certificate issued to an agent. `revokedAt` is the deny-list:
/// the gateway refuses any presented serial that is absent, revoked or expired.
model AgentCertificate {
  id String @id @db.Uuid

  orgId     String @map("org_id") @db.Uuid
  clusterId String @map("cluster_id") @db.Uuid

  /// Lower-case hex of the certificate serial number.
  serial    String    @unique
  notBefore DateTime  @map("not_before") @db.Timestamptz(6)
  notAfter  DateTime  @map("not_after") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cluster Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([clusterId, revokedAt])
  @@map("agent_certificates")
}

/// The internal certificate authority that signs agent certificates and the
/// gateway's own server certificate (PLAN.md §5.1). One row, id `1`: replicas
/// race to create it with `skipDuplicates` and all read back the winner. The
/// private key exists only as an envelope-encrypted value (docs/DECISIONS.md
/// ADR-016).
model CertificateAuthority {
  id Int @id

  certificatePem String   @map("certificate_pem")
  keyEncrypted   String   @map("key_encrypted")
  notAfter       DateTime @map("not_after") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("certificate_authority")
}
