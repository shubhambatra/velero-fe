# Web UI environment. Copy to .env.local for local overrides; .env* is
# git-ignored (PLAN.md §12.1 — no secrets in committed config files, and
# nothing here may ever hold one: every VITE_ variable is inlined into the
# client bundle and is therefore public).

# Base URL of the control plane REST API. Relative by default so the browser
# only ever talks to the origin that served the app, which is what the
# control plane's CSP (connect-src 'self') allows.
VITE_API_BASE_URL=/api/v1

# Dev-server proxy target for /api, /healthz and /readyz. Build tooling only —
# not prefixed with VITE_, so it is never inlined into the bundle.
VFM_DEV_PROXY_TARGET=http://127.0.0.1:3000
