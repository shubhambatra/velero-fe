{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // CommonJS so the NestJS control plane can require it; Vite consumes it
    // happily either way. Declarations ship so both consumers keep types.
    "module": "CommonJS",
    "moduleResolution": "node",
    "verbatimModuleSyntax": false,
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
