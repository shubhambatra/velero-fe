{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // ESM half, and the one that carries the declarations. Rollup needs real
    // ESM to see named exports: a CJS bundle fails the web build with
    // "X is not exported by".
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "outDir": "dist/esm",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
