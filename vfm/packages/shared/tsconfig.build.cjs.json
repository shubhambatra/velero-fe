{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // CommonJS half of the dual build: the NestJS control plane compiles to
    // CJS and cannot require() an ESM package.
    "module": "CommonJS",
    "moduleResolution": "node",
    "verbatimModuleSyntax": false,
    "rootDir": "src",
    "outDir": "dist/cjs",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
